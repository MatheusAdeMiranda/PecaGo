# Template para o ambiente de staging.
# Copie para .env.staging no servidor e preencha os valores reais.
# NÃO versione o .env.staging — apenas este .example.

ENVIRONMENT=staging
DEBUG=False

# PostgreSQL separado do de produção
DATABASE_URL=postgresql+psycopg://usuario:senha@host-staging:5432/pecago_staging
SECRET_KEY=gere-com-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["https://staging.seudominio.com"]

# Mercado Pago — use credenciais de sandbox em staging
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=segredo-webhook-staging
APP_BASE_URL=https://staging.seudominio.com

# Storage: use S3 em staging para espelhar produção
STORAGE_BACKEND=s3
S3_BUCKET=pecago-staging
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=https://pecago-staging.s3.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
