# Template para o ambiente de produção.
# Em produção (Railway, Render, Fly.io) defina as vars diretamente no dashboard
# do provedor — não use arquivo .env.
# Este arquivo serve apenas como documentação das variáveis necessárias.

ENVIRONMENT=production
DEBUG=False

DATABASE_URL=postgresql+psycopg://usuario:senha@host-prod:5432/pecago_production
SECRET_KEY=gere-com-openssl-rand-hex-32

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["https://seudominio.com","https://www.seudominio.com"]

# Mercado Pago — use credenciais de produção (APP_USR-xxx)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=segredo-webhook-producao
APP_BASE_URL=https://seudominio.com

# Storage: sempre S3 em produção
STORAGE_BACKEND=s3
S3_BUCKET=pecago-production
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=https://pecago-production.s3.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
