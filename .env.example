# Ambiente: development | staging | production
# Em produção: DEBUG=False desativa /docs, /redoc e /openapi.json
ENVIRONMENT=development
DEBUG=True

DATABASE_URL=sqlite:///./autoparts_mvp.db
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_ORIGINS=["http://localhost:5173"]

# Mercado Pago (obtenha em https://www.mercadopago.com.br/developers)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:8000

# Storage de imagens: "local" (dev) ou "s3" (produção)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# Sentry (deixe vazio para desativar; obtenha o DSN em sentry.io)
SENTRY_DSN=

# Preencha apenas quando STORAGE_BACKEND=s3
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
